# Copy to private/app.env and chmod 600. Never commit the configured copy.
FAMILY_CALENDAR_ID=your-owned-calendar-id@group.calendar.google.com
GOOGLE_ALLOWED_ACCOUNTS=parent@example.invalid,alias@example.invalid
ASSISTANT_THREAD_ID=your-existing-authorised-chat-id
# Optional absolute path; otherwise codex is resolved using the service PATH.
CODEX_BIN=/usr/local/bin/codex

# Optional exact pupil display name for purple homework highlighting.
PURPLE_HOMEWORK_PUPIL='Child One'
